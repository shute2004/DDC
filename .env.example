# Local relay storage
DDC_DATA_DIR=./data
DDC_MAX_SHARD_BYTES=52428800

# Hugging Face Datasets sync (server-side only)
DDC_ENABLE_HF_SYNC=true
DDC_HF_REPO_ID=your-user/your-dataset
DDC_HF_REPO_TYPE=dataset
DDC_HF_PATH_IN_REPO=data
HF_TOKEN=your-hugging-face-token

# Auto sync behavior
DDC_AUTO_SYNC_ENABLED=true
DDC_AUTO_SYNC_MIN_INTERVAL_SECONDS=180
DDC_AUTO_SYNC_MIN_RECORDS=10
DDC_DELETE_LOCAL_AFTER_SYNC=true
