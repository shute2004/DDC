# Local relay storage
DDC_DATA_DIR=./data
DDC_MAX_SHARD_BYTES=52428800

# Hugging Face Datasets sync (server-side only)
# Leave disabled until both repository ID and token are configured.
DDC_ENABLE_HF_SYNC=false
DDC_HF_REPO_ID=
DDC_HF_REPO_TYPE=dataset
DDC_HF_PATH_IN_REPO=data
HF_TOKEN=

# Auto sync behavior
# Enable this only after Hugging Face sync is configured above.
DDC_AUTO_SYNC_ENABLED=false
DDC_AUTO_SYNC_MIN_INTERVAL_SECONDS=180
DDC_AUTO_SYNC_MIN_RECORDS=10
DDC_DELETE_LOCAL_AFTER_SYNC=true
